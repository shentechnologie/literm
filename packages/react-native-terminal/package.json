{
  "name": "@literm/react-native-terminal",
  "version": "0.1.0",
  "description": "React Native SSH terminal: the native secure-shell module, the Skia terminal view, and the terminal pane (key bar + input).",
  "license": "MIT",
  "homepage": "https://github.com/literm/literm/tree/main/packages/react-native-terminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/literm/literm.git",
    "directory": "packages/react-native-terminal"
  },
  "bugs": {
    "url": "https://github.com/literm/literm/issues"
  },
  "keywords": [
    "terminal",
    "ssh",
    "react-native",
    "expo",
    "skia",
    "libssh2",
    "jsch"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./lib/module/index.js",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "bob build",
    "prepublishOnly": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "vendor": "scripts/vendor-ssh.sh"
  },
  "dependencies": {
    "@literm/terminal-core": "^0.1.0"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "*",
    "expo": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "@types/bun": "^1.3.14",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "typescript": "~6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
