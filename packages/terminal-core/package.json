{
  "name": "@literm/terminal-core",
  "version": "0.1.0",
  "description": "Headless terminal core: xterm parser wrapper, shadow-grid diff, palette, key encoder, and the transport/drain contract for SSH shells.",
  "license": "MIT",
  "homepage": "https://github.com/literm/literm/tree/main/packages/terminal-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/literm/literm.git",
    "directory": "packages/terminal-core"
  },
  "bugs": {
    "url": "https://github.com/literm/literm/issues"
  },
  "keywords": [
    "terminal",
    "xterm",
    "vt",
    "tty",
    "ssh",
    "react-native"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/platform-shim.js",
    "**/platform-shim.ts"
  ],
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "build": "bob build",
    "prepublishOnly": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "bench": "bun run bench/flood.ts"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "~6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
